<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdout = JSON request log in .\logs (must be writable by the app pool identity). -->
      <aspNetCore processPath="dotnet" arguments=".\Checkers.Api.dll" hostingModel="inprocess"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" startupTimeLimit="180" />
    </system.webServer>
  </location>
</configuration>
